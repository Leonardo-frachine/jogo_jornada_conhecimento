PORT=4000
NODE_ENV=development
DB_SYNCHRONIZE=true

# Local SQLite (padrao em desenvolvimento)
DATABASE_PATH=jornada_conhecimento.sqlite
DATABASE_SEED_PATH=jornada_conhecimento.sqlite

# Seed opcional para bancos vazios (SQLite ou Postgres)
DATABASE_SEED_SQL_PATH=sql/perguntas_teste_25.sql

# Ative em producao/Render Postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=false

IA_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
