[gd_scene format=3]

[node name="ProfessorHeader" type="PanelContainer"]
custom_minimum_size = Vector2(0, 116)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18

[node name="HeaderLayout" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleColumn" type="VBoxContainer" parent="Margin/HeaderLayout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="PageTitle" type="Label" parent="Margin/HeaderLayout/TitleColumn"]
layout_mode = 2
text = "Dashboard"

[node name="PageSubtitle" type="Label" parent="Margin/HeaderLayout/TitleColumn"]
layout_mode = 2
text = "Professor:"

[node name="StatusLabel" type="Label" parent="Margin/HeaderLayout/TitleColumn"]
layout_mode = 2
autowrap_mode = 3
text = "Painel pronto."

[node name="Actions" type="HBoxContainer" parent="Margin/HeaderLayout"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 12

[node name="CurrentRoomBadge" type="PanelContainer" parent="Margin/HeaderLayout/Actions"]
layout_mode = 2

[node name="CurrentRoomMargin" type="MarginContainer" parent="Margin/HeaderLayout/Actions/CurrentRoomBadge"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="CurrentRoomLabel" type="Label" parent="Margin/HeaderLayout/Actions/CurrentRoomBadge/CurrentRoomMargin"]
layout_mode = 2
text = "Sem sala ativa"

[node name="SeletorSalas" type="OptionButton" parent="Margin/HeaderLayout/Actions"]
custom_minimum_size = Vector2(250, 44)
layout_mode = 2

[node name="BotaoAtualizarSala" type="Button" parent="Margin/HeaderLayout/Actions"]
custom_minimum_size = Vector2(132, 44)
layout_mode = 2
text = "Atualizar"

[node name="BotaoSair" type="Button" parent="Margin/HeaderLayout/Actions"]
custom_minimum_size = Vector2(154, 44)
layout_mode = 2
text = "Sair do Painel"
