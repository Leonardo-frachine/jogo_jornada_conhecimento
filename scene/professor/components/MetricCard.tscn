[node name="TitleLabel" type="Label" parent="Margin/VBox/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Indicador"

[node name="ValueLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "0"

[node name="SubtitleLabel" type="Label" parent="Margin/VBox"]
